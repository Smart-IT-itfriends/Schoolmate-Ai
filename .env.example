# Telegram Bot Token from BotFather
# Get it here: https://t.me/botfather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Leave empty to use the stable default model.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. Model for photo/voice (Vision). Defaults to GEMINI_MODEL.
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite

# Comma-separated Telegram user IDs with Premium (photo + voice AI).
# Example: PREMIUM_USER_IDS=123456789,987654321
PREMIUM_USER_IDS=

# Optional TTS for foreign-language answers (set to false to disable).
# ENABLE_TTS=true
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Global chat realtime server (SSE + web UI)
GLOBAL_CHAT_PORT=3002
# Optional secret for web chat auth tokens (defaults to TELEGRAM_TOKEN)
# CHAT_WEB_SECRET=your_random_secret

# Legacy alias (also supported by bot.js)
